FROM node:20-slim AS pkg-builder

WORKDIR /pkg
COPY package.json tsconfig.json ./
COPY src/ src/
RUN npm install && npm run build

FROM node:20-slim

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY test-frontend/package.json ./
RUN npm install

COPY test-frontend/ .

RUN mkdir -p node_modules/@pamfilico/pwa-template
COPY --from=pkg-builder /pkg/dist/ node_modules/@pamfilico/pwa-template/dist/
COPY --from=pkg-builder /pkg/package.json node_modules/@pamfilico/pwa-template/package.json

RUN npm run build

EXPOSE 3099
CMD ["npm", "start"]
